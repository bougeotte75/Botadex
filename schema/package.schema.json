{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package Botadex",
  "type": "object",
  "required": ["id", "titre", "niveau", "acces", "genres"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "titre": { "type": "string" },
    "description": { "type": "string" },
    "niveau": { "enum": ["debutant", "intermediaire", "expert"] },
    "acces": { "enum": ["gratuit", "payant"] },
    "prix_eur": { "type": ["number", "null"] },
    "prerequis": { "type": "array", "items": { "type": "string" }, "description": "ids d'autres packages" },
    "rang_requis": { "type": ["integer", "null"], "description": "Rang de botaniste nécessaire pour débloquer le package" },
    "genres": { "type": "array", "items": { "type": "string" }, "description": "ids de fiches genres (contenu/genres/), dans l'ordre d'apprentissage" }
  }
}
